# ── LiveKit ───────────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Public wss:// URL the browser uses; leave empty to use the page's own origin (/rtc)
LIVEKIT_PUBLIC_URL=

# ── Tarka model API (STT, TTS, LLM) ──────────────────────
# Inside a Tarka host use http://tarka/v1 with no key.
TARKA_BASE_URL=https://tarka.rest/v1
TARKA_API_KEY=                           # needs the utilities scope
LLM_MODEL=qwen3.8-flash-next
STT_MODEL=whisper-large-v3
STT_LANGUAGE=en
TTS_MODEL=kokoro
TTS_VOICE=af_heart

# ── RAG Service ──────────────────────────────────────────
RAG_SERVICE_URL=http://rag-service:8100
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# ── Agent ─────────────────────────────────────────────────
AGENT_NAME=rag-assistant
